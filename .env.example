# Copy to .env and fill in. Everything is optional except a listing source.

# Database (default: local SQLite file in data/). Use Postgres on a host.
# DATABASE_URL=postgresql://user:pass@host:5432/offmarket

# Website login (set this before putting the site on the internet)
DASHBOARD_USER=broker
DASHBOARD_PASSWORD=

# Refresh time, New York time
DAILY_RUN_HOUR=6

# Listing feed: REBNY RLS via Trestle (or any RESO Web API: OneKey MLS, Bridge, MLS Grid)
RESO_FEED_NAME=REBNY RLS
RESO_BASE_URL=https://api-trestle.corelogic.com/trestle/odata
RESO_TOKEN_URL=https://api-trestle.corelogic.com/trestle/oidc/connect/token
RESO_CLIENT_ID=
RESO_CLIENT_SECRET=
RESO_SCOPE=api
# or a static token instead of client id/secret:
RESO_ACCESS_TOKEN=
RESO_EXTRA_FILTER=

# No RLS? RentCast listings API (free plan: 50 requests/month): https://www.rentcast.io/api
RENTCAST_API_KEY=

# Free, raises NYC/NY open-data rate limits: https://data.cityofnewyork.us/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# Owner phones/emails with Do Not Call flags (billed per match): https://batchdata.io
BATCHDATA_API_KEY=

# Morning email of new leads (Google Workspace/Gmail: SMTP_USER = your address, SMTP_PASSWORD = an app password)
DIGEST_TO=
SMTP_USER=
SMTP_PASSWORD=
SITE_URL=https://off-market-leads.onrender.com

# Claude-written owner letters (optional)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Letter signature
BROKERAGE_NAME=Conquest
AGENT_NAME=
AGENT_PHONE=
AGENT_EMAIL=
